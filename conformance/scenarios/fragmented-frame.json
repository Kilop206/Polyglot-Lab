{
  "name": "Fragmented TCP frame",
  "steps": [
    {
      "op": "connect"
    },
    {
      "op": "handshake"
    },
    {
      "op": "send_fragmented",
      "type": "ECHO",
      "request_id": 501,
      "payload_utf8": "fragmented",
      "chunks": [
        1,
        2,
        3,
        1,
        4
      ],
      "delay_ms": 2
    },
    {
      "op": "expect",
      "type": "ECHO_RESULT",
      "request_id": 501,
      "payload_utf8": "fragmented"
    },
    {
      "op": "close"
    }
  ]
}
